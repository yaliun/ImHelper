<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DatabaseSettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="DatabaseSettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('DatabaseSettings.Local.json')" />
    <None Update="Sql\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
