<Window x:Class="ImHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImHelper"
        xmlns:views="clr-namespace:ImHelper.Views"
        mc:Ignorable="d"
        Title="ImHelper" Height="800" Width="1200" MinHeight="650" MinWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="파일 생성">
                <MenuItem Header="현업담당자" Click="OwnerContactMenuItem_Click" />
                <MenuItem Header="현장대리인" />
                <MenuItem Header="기타" />
                <MenuItem Header="권한부여" />
            </MenuItem>
        </Menu>

        <ContentControl x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
